{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AcsEmail": {
    "ConnectionString": "<your-acs-connection-string>",
    "SenderAddress": "DoNotReply@<your-azurecomm-domain>.azurecomm.net",
    "RecipientDomain": "ups.com"
  },
  "ReconciliationConfig": {
    "LeaveTypeMapping": {
      "Annual Leave": "Vacation",
      "Casual Leave": "Vacation",
      "Vacation": "Vacation",
      "Unpaid Leave": "Vacation",
      "Sick Leave": "Illness",
      "Sick Leave/Hospitalization": "Illness",
      "Hospitalization": "Illness",
      "Illness": "Illness",
      "Holiday": "Holiday",
      "Special Leave": "Vacation"
    },
    "ExcludeTypes": [ "Holiday" ],
    "HolidayCalendar": [
      { "Date": "2026-01-01", "Name": "New Year's Day" },
      { "Date": "2026-01-15", "Name": "Pongal" },
      { "Date": "2026-01-26", "Name": "Republic Day" },
      { "Date": "2026-04-03", "Name": "Good Friday" },
      { "Date": "2026-04-14", "Name": "Tamil New Year" },
      { "Date": "2026-05-01", "Name": "May Day (Labour Day)" },
      { "Date": "2026-05-28", "Name": "Bakrid" },
      { "Date": "2026-09-14", "Name": "Ganesh Chaturthi" },
      { "Date": "2026-10-02", "Name": "Gandhi Jayanti" },
      { "Date": "2026-10-19", "Name": "Ayudha Pooja" },
      { "Date": "2026-11-09", "Name": "Diwali" },
      { "Date": "2026-12-25", "Name": "Christmas" }
    ]
  }
}
